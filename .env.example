# Contact form delivery (Phase 6) — copy to .env.local and fill in.
# .env.local is gitignored; never commit real keys.

# Required: Resend API key (https://resend.com → API Keys).
RESEND_API_KEY=

# Optional: where contact messages land. Defaults to the brand email in code.
CONTACT_TO_EMAIL=ebraheemgillani1@gmail.com

# Optional: the "from" sender. MUST be a Resend-verified domain/address.
# For first-run testing Resend allows: onboarding@resend.dev
# Swap to your verified domain before launch, e.g. "Ebraheem Gillani <hello@yourdomain.com>"
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
