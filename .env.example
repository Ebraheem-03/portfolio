# Environment — copy to .env.local and fill in.
# .env.local is gitignored; never commit real keys.

# --- Site (Phase 8 deploy) --------------------------------------------------
# Production origin, no trailing slash. Drives metadataBase (absolute OG/
# canonical URLs), robots.txt, and sitemap.xml. Set this in the Vercel project
# to your real domain, e.g. https://ebraheemgillani.com. Falls back to
# http://localhost:3000 in dev so nothing breaks locally.
NEXT_PUBLIC_SITE_URL=

# --- Contact form delivery (Phase 6) ---------------------------------------

# Required: Resend API key (https://resend.com → API Keys).
RESEND_API_KEY=

# Optional: where contact messages land. Defaults to the brand email in code.
CONTACT_TO_EMAIL=ebraheemgillani1@gmail.com

# Optional: the "from" sender. MUST be a Resend-verified domain/address.
# For first-run testing Resend allows: onboarding@resend.dev
# Swap to your verified domain before launch, e.g. "Ebraheem Gillani <hello@yourdomain.com>"
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
